DAIL_CHECKPOINT_PATH=/app/outputs/checkpoints/model_best.pt
DAIL_DEVICE=cpu
DAIL_MAX_CONCURRENT=1
DAIL_MAX_QUEUED=2
DAIL_RATE_LIMIT_REQUESTS=5
DAIL_RATE_LIMIT_WINDOW=60
PORT=8000

# Official Dáil debate index built by scripts.download_debates and dail_llm.qa.index.
# DAIL_QA_INDEX=/app/data/oireachtas/passages.sqlite
# DAIL_QA_DAILY_REQUESTS=100
# For year-sharded Cloudflare D1, supply the provisioned year-to-ID JSON and measured coverage JSON.
# DAIL_D1_DATABASES={"2026":"database-uuid"}
# DAIL_QA_COVERAGE={"first_date":"2014-01-15","last_date":"2026-10-01","days":1298,"passages":0}
# CLOUDFLARE_D1_READ_TOKEN=
# CLOUDFLARE_D1_WRITE_TOKEN=
# Optional free-tier answer generation. Without these, cited excerpts are returned.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# DAIL_QA_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# Optional runtime tracing. User questions and retrieved public passages leave this server.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Offline experiment only: python -m scripts.evaluate_qa <reviewed.jsonl> --langsmith-dataset <new-name>.
# It refuses any question not marked reviewed. Do not set LANGSMITH_TRACING on a public server,
# because that would also send user questions to LangSmith.
# LANGSMITH_API_KEY=

# Optional read-only research bundle. Leave unset for recorded examples only.
# Build with --build-arg INSTALL_RESEARCH=true to enable research dependencies.
# DAIL_RESEARCH_RUN=/research-private
# DAIL_RESEARCH_PUBLIC=/app/frontend/dist/research-data/pilot
