DAIL_CHECKPOINT_PATH=/app/outputs/checkpoints/model_best.pt
DAIL_DEVICE=cpu
DAIL_MAX_CONCURRENT=1
DAIL_MAX_QUEUED=2
DAIL_RATE_LIMIT_REQUESTS=5
DAIL_RATE_LIMIT_WINDOW=60
PORT=8000

# Optional read-only research bundle. Leave unset for recorded examples only.
# Build with --build-arg INSTALL_RESEARCH=true to enable research dependencies.
# DAIL_RESEARCH_RUN=/research-private
# DAIL_RESEARCH_PUBLIC=/app/frontend/dist/research-data/pilot
